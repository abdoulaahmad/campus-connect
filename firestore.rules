rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the requesting user is a member of the chat
    function isMember(chatId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid));
    }

    match /chats/{chatId} {
      allow read: if isMember(chatId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(chatId);
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /typing/{uid} {
        allow read: if isMember(chatId);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      
      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId) 
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.status == 'sent';
          
        allow update: if isMember(chatId)
          && resource.data.sender_id == request.auth.uid
          && request.resource.data.sender_id == resource.data.sender_id
          && request.resource.data.created_at == resource.data.created_at
          && (request.time - resource.data.created_at) < duration.value(2, 'm');
          
        allow delete: if false;
      }
    }
  }
}
